#!/usr/bin/env bash
set -euo pipefail
umask 077

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIRECTORY="$(CDPATH='' cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=scripts/deploy-common.sh
source "$SCRIPT_DIRECTORY/deploy-common.sh"

usage() {
    cat <<'EOF'
Usage: sudo lcc-admin COMMAND [arguments]

Process lifecycle (delegates to systemd):
  start | stop | restart | status

Operations:
  update [--yes] [--dry-run]
                                 Resolve and run the canonical installed updater
  health [--internal|--public]   Check Core loopback or public HTTPS health
  app-port                       Show the internal loopback application port
  app-port set PORT [--dry-run] [--yes] [--ack-external-proxy]
                                 Safely validate or change the internal port
  public-origin                  Show the configured public HTTPS origin
  public-origin set HTTPS_ORIGIN [--dry-run] [--yes]
                                 Change origin and verify Core/gateway health
  logs [LINES]                   Show recent application journal entries
  backup                         Run one SQLite-safe operational backup
  backup-status                  Show timer state, schedule, retention, and recent files
  verify                         Verify the offline database and single-user invariant
  restore /absolute/backup       Restore offline and restart LCC
  recover-password               Reset the password offline from an interactive TTY
  repair-projections [--full]    Drain capability work offline; optionally enqueue all
  show-bootstrap-token           Show pending one-time token on /dev/tty only
  finalize-bootstrap             Remove bootstrap token after first-user creation
EOF
}

test "$(id -u)" -eq 0 || lcc_die "lcc-admin must run as root."
test -r "$LCC_ENVIRONMENT_FILE" || lcc_die "Missing $LCC_ENVIRONMENT_FILE."
test -L "$LCC_CURRENT_RELEASE" || lcc_die "Missing active release symlink."
release_root="$(readlink -f "$LCC_CURRENT_RELEASE")"
test -x "$release_root/.venv/bin/python" || lcc_die "Active production runtime is incomplete."
core_only=0
gateway_mode=legacy
if test -f "$release_root/INSTALLER_V2_CORE"; then
    test "$(cat "$release_root/INSTALLER_V2_CORE")" = 1 || lcc_die "Unknown V2 Core identity."
    core_only=1
    gateway_mode=core-only
    if test -e "$LCC_DEPLOYMENT_STATE_FILE" || test -L "$LCC_DEPLOYMENT_STATE_FILE"; then
        gateway_mode="$(lcc_read_gateway_state)"
    fi
fi
lcc_load_environment "$LCC_ENVIRONMENT_FILE"
lcc_validate_environment "$LCC_CURRENT_RELEASE"

command_name="${1:-}"
test -n "$command_name" || { usage; exit 2; }
shift

case "$command_name" in
    status|health|logs|backup-status|show-bootstrap-token|update|-h|--help|help) ;;
    app-port|public-origin)
        if test "${1:-}" = set; then
            lcc_acquire_deployment_lock
        fi
        ;;
    *) lcc_acquire_deployment_lock ;;
esac

timer_was_active=0
pause_backup_timer() {
    if systemctl is-active --quiet "$LCC_BACKUP_TIMER_NAME"; then
        timer_was_active=1
        systemctl stop "$LCC_BACKUP_TIMER_NAME"
    fi
    if systemctl is-active --quiet "$LCC_BACKUP_SERVICE_NAME"; then
        lcc_die "A backup is currently running; wait for it to finish."
    fi
    # Cancel a queued timer activation and wait until the oneshot is definitely
    # inactive before an exclusive database operation begins.
    systemctl stop "$LCC_BACKUP_SERVICE_NAME"
}

resume_backup_timer() {
    if test "$timer_was_active" -eq 1; then
        systemctl start "$LCC_BACKUP_TIMER_NAME"
    fi
}

run_offline() {
    lcc_require_inactive_service
    trap resume_backup_timer EXIT
    pause_backup_timer
    lcc_run_as_service_user "$release_root" "$@"
    resume_backup_timer
    trap - EXIT
}

case "$command_name" in
    start|stop|restart)
        test "$#" -eq 0 || lcc_die "$command_name accepts no arguments."
        systemctl "$command_name" "$LCC_SERVICE_NAME"
        ;;
    status)
        test "$#" -eq 0 || lcc_die "status accepts no arguments."
        release_id="$(tr -d '\r\n' < "$release_root/RELEASE_ID")"
        release_channel="$(lcc_release_channel "$release_root")"
        source_revision="$(lcc_release_source_revision "$release_root")"
        echo "Channel: $release_channel"
        echo "Release ID: $release_id"
        echo "Source revision: $source_revision"
        if test "$core_only" -eq 1; then
            if test -x "$LCC_UPDATE_ENTRYPOINT"; then
                echo "Updater: $LCC_UPDATE_ENTRYPOINT"
            else
                echo "Updater: unavailable"
            fi
            echo "Gateway mode: $gateway_mode"
            echo "Internal app port: $(lcc_effective_app_port)"
            echo "Public origin: ${LCC_PUBLIC_ORIGIN:-not configured (pending)}"
            if systemctl is-active --quiet "$LCC_SERVICE_NAME"; then
                echo "Core service: active"
            else
                echo "Core service: inactive/failed"
            fi
            if lcc_wait_for_internal_health "$(lcc_effective_app_port)" 1 0; then
                echo "Internal Core health: healthy"
            else
                echo "Internal Core health: unhealthy"
            fi
            if test "$gateway_mode" = caddy; then
                if systemctl is-active --quiet caddy.service; then
                    echo "Managed Caddy service: active"
                else
                    echo "Managed Caddy service: inactive/failed"
                fi
                if "$LCC_CADDY_BINARY" validate --config "$LCC_CADDY_MAIN" --adapter caddyfile \
                    >/dev/null 2>&1; then
                    echo "Managed Caddy configuration: valid"
                else
                    echo "Managed Caddy configuration: invalid/unavailable"
                fi
            fi
            if test "$gateway_mode" = core-only; then
                echo "Public gateway/TLS: pending (no gateway selected)"
            elif test -z "${LCC_PUBLIC_ORIGIN:-}"; then
                echo "Public gateway/TLS: pending (public origin not configured)"
            elif lcc_wait_for_health 1 0; then
                echo "Public HTTPS health: healthy"
            else
                echo "Public gateway/TLS: pending/unhealthy"
            fi
        fi
        systemctl status "$LCC_SERVICE_NAME" --no-pager
        ;;
    health)
        test "$#" -le 1 || lcc_die "health accepts only --internal or --public."
        health_scope="${1:---public}"
        case "$health_scope" in --internal|--public) ;; *) lcc_die "health accepts only --internal or --public." ;; esac
        if test "$core_only" -eq 1 && test "$#" -eq 0 && test "$gateway_mode" = core-only; then
            health_scope=--internal
        fi
        if test "$health_scope" = --internal; then
            port="$(lcc_effective_app_port)"
            internal_hostname="$(lcc_public_hostname)"
            internal_hostname="${internal_hostname:-127.0.0.1}"
            curl --fail --silent --show-error --max-time 10 \
                --header "Host: $internal_hostname" \
                "http://127.0.0.1:$port/api/v1/health"
            printf '\n'
            if test "$gateway_mode" = core-only; then echo 'Public gateway/TLS: pending'; fi
            exit 0
        fi
        test "$gateway_mode" != core-only && test -n "${LCC_PUBLIC_ORIGIN:-}" ||
            lcc_die "Public gateway/TLS is pending; a gateway and public origin must be configured."
        curl --fail --silent --show-error --max-time 10 \
            "$LCC_PUBLIC_ORIGIN/api/v1/health"
        printf '\n'
        ;;
    app-port)
        if test "$#" -eq 0; then
            current_app_port="$(lcc_effective_app_port)"
            echo "Internal application port: $current_app_port"
            echo "Bind address: 127.0.0.1"
            if lcc_app_port_is_explicit; then
                echo "Configuration: explicit (LCC_APP_PORT)"
            else
                echo "Configuration: legacy default 8000"
            fi
            exit 0
        fi
        test "$1" = set || lcc_die "app-port accepts no arguments or: set PORT [--dry-run] [--yes] [--ack-external-proxy]"
        test "$gateway_mode" != core-only || lcc_die "Core-only app-port changes require a configured gateway mode; no changes made."
        shift
        test "$#" -ge 1 || lcc_die "app-port set requires PORT."
        requested_app_port="$(lcc_validate_app_port "$1")"
        shift
        app_port_dry_run=0
        app_port_assume_yes=0
        external_ack=0
        while test "$#" -gt 0; do
            case "$1" in
                --dry-run) app_port_dry_run=1 ;;
                --yes) app_port_assume_yes=1 ;;
                --ack-external-proxy) external_ack=1 ;;
                *) lcc_die "Unknown app-port set option: $1" ;;
            esac
            shift
        done
        test "$external_ack" -eq 0 || test "$gateway_mode" = external ||
            lcc_die "--ack-external-proxy applies only to external gateway mode."
        if test "$gateway_mode" = external && test "$app_port_dry_run" -eq 0 &&
            test "$app_port_assume_yes" -eq 1 && test "$external_ack" -eq 0; then
            lcc_die "External mode requires --ack-external-proxy with --yes; update your reverse proxy after changing the upstream."
        fi
        current_app_port="$(lcc_effective_app_port)"
        if test "$requested_app_port" = "$current_app_port"; then
            echo "Internal application port is already $current_app_port; no changes were made."
            exit 0
        fi
        if ! lcc_app_port_is_available "$requested_app_port"; then
            lcc_describe_app_port_listener "$requested_app_port"
            lcc_die "Internal application port $requested_app_port is already occupied."
        fi
        echo "Internal application port: $current_app_port -> $requested_app_port"
        echo "Bind address remains: 127.0.0.1"
        if test "$gateway_mode" = external; then
            echo "External proxy coordination: you must update its upstream after this change."
            echo "Public HTTPS may be pending until operator routing is updated."
        fi
        if test "$app_port_dry_run" -eq 0 && test "$app_port_assume_yes" -eq 0; then
            exec 3<>/dev/tty || \
                lcc_die "Interactive confirmation requires a controlling terminal; use --yes for deliberate automation."
            if test "$gateway_mode" = external; then
                printf 'Change Core port and coordinate the external proxy yourself? [y/N]: ' >&3
            else
                printf 'Apply this internal application-port change? [y/N]: ' >&3
            fi
            IFS= read -r answer <&3 || lcc_die "Unable to read app-port confirmation."
            case "${answer,,}" in
                y|yes) ;;
                *) lcc_die "App-port change cancelled." ;;
            esac
        fi
        if test "$gateway_mode" = external; then
            lcc_apply_external_app_port_change "$requested_app_port" "$app_port_dry_run"
        else
            lcc_apply_app_port_change "$requested_app_port" "$app_port_dry_run"
        fi
        ;;
    public-origin)
        if test "$#" -eq 0; then
            echo "Public origin: ${LCC_PUBLIC_ORIGIN:-not configured (pending)}"
            exit 0
        fi
        test "$1" = set || lcc_die "public-origin accepts no arguments or: set HTTPS_ORIGIN [--dry-run] [--yes]"
        shift
        test "$#" -ge 1 || lcc_die "public-origin set requires HTTPS_ORIGIN."
        requested_public_origin="$1"
        lcc_validate_public_origin "$requested_public_origin"
        shift
        public_origin_dry_run=0
        public_origin_assume_yes=0
        while test "$#" -gt 0; do
            case "$1" in
                --dry-run) public_origin_dry_run=1 ;;
                --yes) public_origin_assume_yes=1 ;;
                *) lcc_die "Unknown public-origin set option: $1" ;;
            esac
            shift
        done
        test "$gateway_mode" = external || test "$gateway_mode" = caddy ||
            lcc_die "Select a gateway before changing the public origin."
        echo "Public origin: ${LCC_PUBLIC_ORIGIN:-not configured} -> $requested_public_origin"
        if test "$gateway_mode" = external; then
            echo 'The external gateway remains operator-managed; public HTTPS may be pending.'
        fi
        if test "$public_origin_dry_run" -eq 0 && test "$public_origin_assume_yes" -eq 0; then
            exec 3<>/dev/tty || lcc_die "Interactive confirmation requires a terminal; use --yes for automation."
            printf 'Apply this public-origin change? [y/N]: ' >&3
            IFS= read -r answer <&3 || lcc_die "Unable to read public-origin confirmation."
            case "${answer,,}" in y|yes) ;; *) lcc_die "Public-origin change cancelled." ;; esac
        fi
        lcc_apply_public_origin_change "$requested_public_origin" "$gateway_mode" "$public_origin_dry_run"
        ;;
    logs)
        lines="${1:-100}"
        [[ "$lines" =~ ^[1-9][0-9]*$ ]] || lcc_die "logs line count must be positive."
        journalctl -u "$LCC_SERVICE_NAME" -n "$lines" --no-pager
        ;;
    update)
        test -x "$LCC_UPDATE_ENTRYPOINT" || \
            lcc_die "Installed update entrypoint is unavailable: $LCC_UPDATE_ENTRYPOINT"
        exec "$LCC_UPDATE_ENTRYPOINT" "$@"
        ;;
    backup)
        test "$#" -eq 0 || lcc_die "backup accepts no arguments."
        backup_marker="$(mktemp /run/learning-control-center-backup.XXXXXX)"
        trap 'rm -f -- "$backup_marker"' EXIT
        systemctl start --wait "$LCC_BACKUP_SERVICE_NAME"
        latest="$(find "$LCC_BACKUP_DIRECTORY" -maxdepth 1 -type f \
            -name 'lcc-scheduled-*.sqlite3' -newer "$backup_marker" \
            -printf '%T@ %p\n' | sort -nr | sed -n '1s/^[^ ]* //p')"
        test -n "$latest" || lcc_die "Backup service completed without a scheduled backup file."
        rm -f -- "$backup_marker"
        trap - EXIT
        echo "$latest"
        ;;
    backup-status)
        test "$#" -eq 0 || lcc_die "backup-status accepts no arguments."
        echo "Backup directory: $LCC_BACKUP_DIRECTORY"
        echo "Scheduled retention: ${LCC_BACKUP_RETENTION_COUNT:-14}"
        systemctl is-enabled "$LCC_BACKUP_TIMER_NAME" || true
        systemctl list-timers "$LCC_BACKUP_TIMER_NAME" --all --no-pager
        systemctl status "$LCC_BACKUP_SERVICE_NAME" --no-pager || true
        find "$LCC_BACKUP_DIRECTORY" -maxdepth 1 -type f -name 'lcc-*.sqlite3' \
            -printf '%TY-%Tm-%TdT%TH:%TM:%TS %s %p\n' | sort -r | sed -n '1,10p'
        ;;
    verify)
        test "$#" -eq 0 || lcc_die "verify accepts no arguments."
        run_offline "$release_root/.venv/bin/lcc-ops" verify
        ;;
    restore)
        test "$#" -eq 1 || lcc_die "restore requires one absolute backup path."
        [[ "$1" = /* ]] || lcc_die "Restore source must be an absolute path."
        restore_source="$(readlink -f "$1")"
        test -f "$restore_source" || lcc_die "Restore source does not exist."
        runuser -u "$LCC_SERVICE_USER" -- test -r "$restore_source" || \
            lcc_die "The lcc service user cannot read the restore source."
        run_offline "$release_root/.venv/bin/lcc-ops" restore --from "$restore_source"
        systemctl start "$LCC_SERVICE_NAME"
        if test "$core_only" -eq 1; then
            lcc_wait_for_internal_health "$(lcc_effective_app_port)" 120 0.5 ||
                lcc_die "Restore succeeded, but internal Core health failed."
            if test "$gateway_mode" = caddy; then
                lcc_wait_for_health 60 0.5 || lcc_die "Restore succeeded, but managed public HTTPS health failed."
            fi
        else
            lcc_wait_for_health 60 0.5 || lcc_die "Restore succeeded, but the public health check failed."
        fi
        ;;
    recover-password)
        test "$#" -eq 0 || lcc_die "recover-password accepts no arguments."
        test -t 0 && test -t 2 || lcc_die "Password recovery requires an interactive terminal."
        run_offline "$release_root/.venv/bin/lcc-ops" recover-password
        ;;
    repair-projections)
        if test "$#" -eq 0; then
            repair_arguments=()
        elif test "$#" -eq 1 && test "$1" = "--full"; then
            repair_arguments=(--enqueue-full-rebuild)
        else
            lcc_die "repair-projections accepts only optional --full."
        fi
        run_offline "$release_root/.venv/bin/python" -m app.capability_cli \
            "${repair_arguments[@]}"
        ;;
    show-bootstrap-token)
        test "$#" -eq 0 || lcc_die "show-bootstrap-token accepts no arguments."
        test -n "${LCC_BOOTSTRAP_TOKEN:-}" || lcc_die "Bootstrap token is not configured."
        case "$LCC_DATABASE_URL" in
            sqlite:////*) database_path="${LCC_DATABASE_URL#sqlite:///}" ;;
            *) lcc_die "Configured database is not an absolute SQLite URL." ;;
        esac
        test -f "$database_path" || lcc_die "Production database does not exist."
        user_count="$(sqlite3 -readonly "$database_path" 'SELECT COUNT(*) FROM users;')" || \
            lcc_die "Unable to verify bootstrap state."
        test "$user_count" = 0 || \
            lcc_die "Bootstrap is no longer pending; run finalize-bootstrap instead."
        exec 3<>/dev/tty || lcc_die "show-bootstrap-token requires an interactive terminal."
        test -t 3 || lcc_die "show-bootstrap-token requires an interactive terminal."
        printf 'One-time Learning Control Center bootstrap token:\n%s\n' \
            "$LCC_BOOTSTRAP_TOKEN" >&3
        ;;
    finalize-bootstrap)
        test "$#" -eq 0 || lcc_die "finalize-bootstrap accepts no arguments."
        grep -q '^LCC_BOOTSTRAP_TOKEN=' "$LCC_ENVIRONMENT_FILE" || \
            lcc_die "Bootstrap token is already absent."
        systemctl stop "$LCC_SERVICE_NAME"
        trap resume_backup_timer EXIT
        pause_backup_timer
        lcc_run_as_service_user "$release_root" "$release_root/.venv/bin/lcc-ops" verify
        temporary_environment="$(mktemp "${LCC_ENVIRONMENT_FILE}.XXXXXX")"
        awk '!/^LCC_BOOTSTRAP_TOKEN=/' "$LCC_ENVIRONMENT_FILE" > "$temporary_environment"
        chown "root:$LCC_SERVICE_GROUP" "$temporary_environment"
        chmod 0640 "$temporary_environment"
        mv -f "$temporary_environment" "$LCC_ENVIRONMENT_FILE"
        lcc_load_environment "$LCC_ENVIRONMENT_FILE"
        resume_backup_timer
        trap - EXIT
        systemctl start "$LCC_SERVICE_NAME"
        if test "$core_only" -eq 1; then
            lcc_wait_for_internal_health "$(lcc_effective_app_port)" 120 0.5 ||
                lcc_die "Bootstrap was finalized, but internal Core health failed."
            if test "$gateway_mode" = caddy; then
                lcc_wait_for_health 60 0.5 || lcc_die "Bootstrap was finalized, but managed public HTTPS health failed."
                echo "Bootstrap token removed; Core and managed public HTTPS health passed."
            else
                echo "Bootstrap token removed; Core restart and internal health passed. Public gateway/TLS may be pending."
            fi
        else
            lcc_wait_for_health 60 0.5 || lcc_die "Bootstrap was finalized, but the public health check failed."
            echo "Bootstrap token removed; production restart and HTTPS health check passed."
        fi
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        lcc_die "Unknown command: $command_name"
        ;;
esac
