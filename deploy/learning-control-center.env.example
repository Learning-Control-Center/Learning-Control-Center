# Learning Control Center production environment for Ubuntu 24.04 LTS.
# Copy to /etc/learning-control-center.env, replace every CHANGE_ME value,
# then keep the installed file root:lcc 0640.
#
# Values containing JSON arrays are single-quoted deliberately. This syntax is
# accepted by systemd EnvironmentFile and preserves the JSON quotes Pydantic needs.

# Required application mode and persistent paths. Keep the database and backups
# in separate directories outside the application release tree.
LCC_ENVIRONMENT=production
LCC_DATABASE_URL=sqlite:////var/lib/learning-control-center/lcc.sqlite3
LCC_BACKUP_DIRECTORY=/var/backups/learning-control-center
LCC_RELEASE_ROOT=/opt/learning-control-center/current

# Required public deployment identity. The three values must describe the same
# HTTPS hostname. Do not include a path or trailing slash.
LCC_PUBLIC_ORIGIN=https://CHANGE_ME.example.com
LCC_ALLOWED_ORIGINS='["https://CHANGE_ME.example.com"]'
LCC_ALLOWED_HOSTS='["CHANGE_ME.example.com"]'

# Caddy connects to Uvicorn over IPv4 loopback. LCC parses X-Forwarded-For only
# from this explicitly trusted proxy range.
LCC_TRUSTED_PROXY_CIDRS='["127.0.0.1/32"]'

# Required independent operator secrets. Use long random values with at least
# 32 characters and 12 distinct characters. Remove the bootstrap line with
# `sudo lcc-admin finalize-bootstrap` immediately after creating the first user.
LCC_BOOTSTRAP_TOKEN=CHANGE_ME_INITIAL_BOOTSTRAP_TOKEN
LCC_SECURITY_SECRET=CHANGE_ME_INDEPENDENT_SECURITY_SECRET

# Required application timezone (IANA name).
LCC_APP_TIMEZONE=UTC

# Optional operational settings. These values show the application defaults.
LCC_SESSION_COOKIE_NAME=lcc_session
LCC_SESSION_IDLE_TIMEOUT_MS=604800000
LCC_SESSION_ABSOLUTE_TIMEOUT_MS=2592000000
LCC_MAX_IMPORT_BYTES=10485760
LCC_LOGIN_RATE_LIMIT_ATTEMPTS=5
LCC_LOGIN_RATE_LIMIT_WINDOW_MS=300000
LCC_IMPORT_RATE_LIMIT_ATTEMPTS=10
LCC_IMPORT_RATE_LIMIT_WINDOW_MS=600000
LCC_BACKUP_RETENTION_COUNT=14
